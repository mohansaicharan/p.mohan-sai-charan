print("RAILWAY FARE AND RESERVATION CALCULATOR")

distance = float(input("Enter travel distance in km: "))
n = int(input("Enter number of passengers: "))

for i in range(n):
    print("\nPassenger", i + 1)

    name = input("Enter passenger name: ")
    age = int(input("Enter passenger age: "))

    print("1. Sleeper")
    print("2. AC")

    choice = int(input("Select class (1 or 2): "))

    if choice == 1:
        rate = 1.50
        reservation_fee = 40
        class_name = "Sleeper"

    elif choice == 2:
        rate = 3.00
        reservation_fee = 80
        class_name = "AC"

    else:
        print("Invalid class selection!")
        continue

    base_fare = distance * rate

    if age <= 5:
        concession = base_fare
    elif age >= 60:
        concession = base_fare * 0.20
    else:
        concession = 0

    discounted_fare = base_fare - concession

    total_fare = discounted_fare + reservation_fee

    print("\nTicket Details")
    print("Passenger Name:", name)
    print("Age:", age)
    print("Class:", class_name)
    print("Base Fare: Rs.", round(base_fare, 2))
    print("Age Concession: Rs.", round(concession, 2))
    print("Reservation Fee: Rs.", reservation_fee)
    print("Total Ticket Fare: Rs.", round(total_fare, 2))

    cancelled = input("Cancel ticket? (yes/no): ").lower()

    if cancelled == "yes":
        penalty = discounted_fare * 0.25
        refund = total_fare - penalty - reservation_fee

        print("Cancellation Penalty: Rs.", round(penalty, 2))
        print("Non-refundable Reservation Fee: Rs.",
              reservation_fee)
        print("Refund Amount: Rs.", round(refund, 2))

    else:
        print("Amount Payable: Rs.", round(total_fare, 2))

print("\nRailway calculation completed.")
