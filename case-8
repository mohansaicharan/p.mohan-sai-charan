print("MANUFACTURING COST AND PROFITABILITY ANALYSIS")

product_name = input("Enter product name: ")
quantity = int(input("Enter production quantity: "))

material_cost = float(input("Enter raw material cost per unit: Rs. "))
labor_cost = float(input("Enter labor cost per unit: Rs. "))
overhead_cost = float(input("Enter total overhead cost: Rs. "))

selling_price = float(input("Enter selling price per unit: Rs. "))

# Calculate costs
total_material_cost = material_cost * quantity
total_labor_cost = labor_cost * quantity

total_cost = (
    total_material_cost
    + total_labor_cost
    + overhead_cost
)

cost_per_unit = total_cost / quantity

# Calculate revenue and profit
total_revenue = selling_price * quantity
profit_or_loss = total_revenue - total_cost

if total_cost > 0:
    profit_percentage = (profit_or_loss / total_cost) * 100
else:
    profit_percentage = 0

# Display results
print("\n----- PRODUCTION REPORT -----")
print("Product Name:", product_name)
print("Production Quantity:", quantity)

print("Total Material Cost: Rs.", round(total_material_cost, 2))
print("Total Labor Cost: Rs.", round(total_labor_cost, 2))
print("Overhead Cost: Rs.", round(overhead_cost, 2))

print("Total Manufacturing Cost: Rs.", round(total_cost, 2))
print("Cost Per Unit: Rs.", round(cost_per_unit, 2))
print("Total Revenue: Rs.", round(total_revenue, 2))

if profit_or_loss > 0:
    print("Profit: Rs.", round(profit_or_loss, 2))
elif profit_or_loss < 0:
    print("Loss: Rs.", round(abs(profit_or_loss), 2))
else:
    print("No Profit, No Loss")

print("Profit/Loss Percentage:", round(profit_percentage, 2), "%")
print("-----------------------------")
